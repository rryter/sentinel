{
  "name": "component-inspector",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sentinel/component-inspector/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build-lib": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/sentinel/component-inspector/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/sentinel/component-inspector/tsconfig.lib.json"
        },
        "development": {
          "tsConfig": "libs/sentinel/component-inspector/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "build-plugin": {
      "dependsOn": ["build-lib"],
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/sentinel/component-inspector/plugin",
        "main": "libs/sentinel/component-inspector/src/plugin/index.ts",
        "tsConfig": "libs/sentinel/component-inspector/tsconfig.plugin.json",
        "rootDir": "libs/sentinel/component-inspector/src/plugin",
        "assets": []
      }
    },
    "build": {
      "dependsOn": ["build-plugin"],
      "executor": "nx:noop",
      "outputs": []
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/sentinel/component-inspector/jest.config.ts",
        "tsConfig": "libs/sentinel/component-inspector/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "dist/libs/sentinel/component-inspector"
      }
    }
  }
}
